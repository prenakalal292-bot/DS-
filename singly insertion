    printf("--- Singly Linked List Operations ---\n");


    insertAtBeginning(&head, 10);
    insertAtBeginning(&head, 20);
    display(head);


    insertAtEnd(&head, 30);
    insertAtEnd(&head, 40);
    display(head);


    insertAtPosition(&head, 3, 25);
    display(head);

    insertAtPosition(&head, 1, 50);
    display(head);

    insertAtPosition(&head, 8, 99);

    freeList(head);
    return 0;
}
